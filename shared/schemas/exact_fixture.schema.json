{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strategy-innovation.local/schemas/exact_fixture.schema.json",
  "title": "Lean–Julia exact finite fixture",
  "description": "Versioned interchange record for deterministic finite Rational{BigInt}/ℚ consistency fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fixture_id",
    "theorem_family",
    "beliefs",
    "transition_rows",
    "discount",
    "modules",
    "strategies",
    "libraries",
    "projects",
    "expected"
  ],
  "properties": {
    "schema_version": {
      "const": "lean-julia-exact-fixture-v2"
    },
    "fixture_id": {
      "$ref": "#/$defs/identifier"
    },
    "theorem_family": {
      "type": "string",
      "minLength": 1
    },
    "beliefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "transition_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/rational"
        }
      }
    },
    "discount": {
      "$ref": "#/$defs/rational"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "strategies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operational_profile", "modules"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "operational_profile": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/rational"
            }
          },
          "modules": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "libraries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "strategies"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "strategies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "cost",
          "duration",
          "survival",
          "strict_cost",
          "required_modules",
          "candidate_strategies"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "cost": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/rational"
            }
          },
          "duration": {
            "type": "integer",
            "minimum": 1
          },
          "survival": {
            "$ref": "#/$defs/rational"
          },
          "strict_cost": {
            "type": "boolean"
          },
          "required_modules": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "candidate_strategies": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rational_scalars",
        "rational_vectors",
        "boolean_scalars",
        "boolean_vectors",
        "string_vectors"
      ],
      "properties": {
        "rational_scalars": {
          "$ref": "#/$defs/namedRationalScalars"
        },
        "rational_vectors": {
          "$ref": "#/$defs/namedRationalVectors"
        },
        "boolean_scalars": {
          "$ref": "#/$defs/namedBooleanScalars"
        },
        "boolean_vectors": {
          "$ref": "#/$defs/namedBooleanVectors"
        },
        "string_vectors": {
          "$ref": "#/$defs/namedStringVectors"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "rational": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)//[1-9][0-9]*$"
    },
    "namedRationalScalars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "value": {
            "$ref": "#/$defs/rational"
          }
        }
      }
    },
    "namedRationalVectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "values"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/rational"
            }
          }
        }
      }
    },
    "namedBooleanScalars": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "value"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "value": {
            "type": "boolean"
          }
        }
      }
    },
    "namedBooleanVectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "values"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "namedStringVectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "values"],
        "properties": {
          "id": {
            "$ref": "#/$defs/identifier"
          },
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    }
  }
}
